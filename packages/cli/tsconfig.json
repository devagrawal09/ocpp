{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "noUncheckedIndexedAccess": false,
    // Core's sources reach the Specter packages @ocpp/session-runtime links, which bring the Specter
    // checkout's copy of effect: types resolve to OC++'s one copy, as core's own tsconfig maps them.
    "paths": {
      "effect*": ["./node_modules/effect/dist/index.d.ts"],
      "effect/*": ["./node_modules/effect/dist/*.d.ts", "./node_modules/effect/dist/*/index.d.ts"]
    }
  },
  "exclude": ["dist", "dist-node"]
}
