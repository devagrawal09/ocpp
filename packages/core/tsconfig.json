{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "incremental": true,
    "noEmit": false,
    "noUncheckedIndexedAccess": false,
    // The linked Specter runtime declares its types against its own copy of effect. Map effect to
    // OC++'s declarations so both sides name the same types. Bun ignores .d.ts targets at runtime; the
    // runtime side is unified by src/specter/single-effect.ts. The bare `effect` key is spelled
    // `effect*` because drizzle-kit applies exact keys at runtime but skips this wildcard form.
    "paths": {
      "effect*": ["./node_modules/effect/dist/index.d.ts"],
      "effect/*": ["./node_modules/effect/dist/*.d.ts", "./node_modules/effect/dist/*/index.d.ts"]
    },
    "outDir": "node_modules/.ts-dist/source",
    "rootDir": "src",
    "tsBuildInfoFile": "node_modules/.ts-dist/source.tsbuildinfo"
  },
  "include": ["src"]
}
