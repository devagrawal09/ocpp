{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@ocpp/plugin",
  "version": "1.18.15",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "bun test --timeout 5000",
    "typecheck": "tsgo --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "exports": {
    ".": "./src/promise/index.ts",
    "./effect": "./src/effect/index.ts",
    "./tui": "./src/tui/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@ocpp/ai": "workspace:*",
    "@ocpp/client": "workspace:*",
    "@ocpp/protocol": "workspace:*",
    "@ocpp/schema": "workspace:*",
    "@standard-schema/spec": "catalog:",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@ocpp/theme": "workspace:*",
    "@opentui/core": ">=0.5.9",
    "@opentui/solid": ">=0.5.9",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@ocpp/theme": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ocpp/theme": "workspace:*",
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
