{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Admits a Code Mode program in a live Session: it reserves every name the program declares, so the execution alone may save them, and it sees the notebook as it is now. A program whose names the notebook holds, or another running execution reserved, is refused, and so is one that would grow the notebook past its limits.",
  "formatVersion": 2,
  "kind": "command",
  "name": "admitCodeModeExecution",
  "scenarios": [
    {
      "description": "A program is admitted with the notebook it sees and the names it reserves.",
      "expect": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_2",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "b"
            ],
            "sessionID": "ses_1",
            "snapshot": [
              "a"
            ],
            "toolCallID": "call_exe_2"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "ses_1",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_exe_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-settled",
          "examplePayload": {
            "executionID": "exe_1",
            "outcome": "finished",
            "sessionID": "ses_1",
            "values": {
              "a": 1
            }
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "assistantMessageID": "msg_1",
        "executionID": "exe_2",
        "limits": {
          "bytes": 100,
          "values": 3
        },
        "program": {
          "source": "const a = 1",
          "version": 1
        },
        "reserved": [
          "b"
        ],
        "sessionID": "ses_1",
        "toolCallID": "call_exe_2"
      }
    },
