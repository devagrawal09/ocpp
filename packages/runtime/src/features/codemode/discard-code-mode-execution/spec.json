{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Withdraws an admitted Code Mode execution that never started, when its Session had no slot free: its names are released as if it was never admitted. An execution that started settles instead.",
  "formatVersion": 2,
  "kind": "command",
  "name": "discardCodeModeExecution",
  "scenarios": [
    {
      "description": "An admitted execution that never started is withdrawn.",
      "expect": [
        {
          "eventType": "session-codemode-execution-discarded",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "executionID": "exe_1"
      }
    },
    {
      "description": "A running execution is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-started",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "execution-already-started"
      },
      "when": {
        "executionID": "exe_1"
      }
    },
    {
      "description": "A settled execution is forgotten: it is refused as unknown, which the host answers as done.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-settled",
          "examplePayload": {
            "error": "Boom",
            "executionID": "exe_1",
            "outcome": "failed",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "execution-not-found"
      },
      "when": {
        "executionID": "exe_1"
      }
    },
    {
      "description": "A discarded execution is gone.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-discarded",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "execution-not-found"
      },
      "when": {
        "executionID": "exe_1"
      }
    },
    {
      "description": "A deleted Session's execution is gone: its deletion settled it, and its tombstone forgets it.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-settled",
          "examplePayload": {
            "error": "The Session was deleted; nothing was saved.",
            "executionID": "exe_1",
            "outcome": "failed",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-deleted",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "execution-not-found"
      },
      "when": {
        "executionID": "exe_1"
      }
    }
  ]
}
