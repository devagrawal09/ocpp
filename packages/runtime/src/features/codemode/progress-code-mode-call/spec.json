{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Records the latest progress of a journaled call that can rejoin its work after a restart, such as the child Session a subagent call runs in.",
  "formatVersion": 2,
  "kind": "command",
  "name": "progressCodeModeCall",
  "scenarios": [
    {
      "description": "A journaled call's progress is recorded.",
      "expect": [
        {
          "eventType": "session-codemode-call-progressed",
          "examplePayload": {
            "executionID": "exe_1",
            "index": 0,
            "progress": {
              "sessionID": "ses_child"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "await task()",
              "version": 1
            },
            "reserved": [],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-started",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-call-scheduled",
          "examplePayload": {
            "executionID": "exe_1",
            "index": 0,
            "input": {
              "prompt": "Plan"
            },
            "omitted": false,
            "sessionID": "ses_1",
            "tool": "task"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "executionID": "exe_1",
        "index": 0,
        "progress": {
          "sessionID": "ses_child"
        }
      }
    },
    {
      "description": "A call never journaled is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "await task()",
              "version": 1
            },
            "reserved": [],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-started",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "call-not-scheduled"
      },
      "when": {
        "executionID": "exe_1",
        "index": 0,
        "progress": {
          "sessionID": "ses_child"
        }
      }
    },
    {
      "description": "A settled execution's call is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "await task()",
              "version": 1
            },
            "reserved": [],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-started",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-call-scheduled",
          "examplePayload": {
            "executionID": "exe_1",
            "index": 0,
            "input": {
              "prompt": "Plan"
            },
            "omitted": false,
            "sessionID": "ses_1",
            "tool": "task"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-settled",
          "examplePayload": {
            "error": "Boom",
            "executionID": "exe_1",
            "outcome": "failed",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "execution-not-running"
      },
      "when": {
        "executionID": "exe_1",
        "index": 0,
        "progress": {
          "sessionID": "ses_child"
        }
      }
    },
    {
      "description": "An unknown execution is refused.",
      "expect": [],
      "given": [],
      "reject": {
        "code": "execution-not-found"
      },
      "when": {
        "executionID": "exe_1",
        "index": 0,
        "progress": {
          "sessionID": "ses_child"
        }
      }
    }
  ]
}
