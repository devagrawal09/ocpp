{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Removes a slash command a live Session defined, or that its fork copied. A command the Session does not have records nothing.",
  "formatVersion": 2,
  "kind": "command",
  "name": "removeCodeModeCommand",
  "scenarios": [
    {
      "description": "A command the Session defined is removed.",
      "expect": [
        {
          "eventType": "session-codemode-command-removed",
          "examplePayload": {
            "name": "deploy",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "ses_1",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-command-defined",
          "examplePayload": {
            "description": "Deploy the app",
            "handler": "deploy",
            "name": "deploy",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "name": "deploy",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A fork's command, copied with its notebook, is the fork's own.",
      "expect": [
        {
          "eventType": "session-codemode-command-removed",
          "examplePayload": {
            "name": "deploy",
            "sessionID": "ses_2"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "ses_1",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-command-defined",
          "examplePayload": {
            "description": "Deploy the app",
            "handler": "deploy",
            "name": "deploy",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_2",
            "slug": "ses_2",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-notebook-copied",
          "examplePayload": {
            "commands": {
              "deploy": {
                "created": 1,
                "description": "Deploy the app",
                "handler": "deploy",
                "updated": 1
              }
            },
            "events": {},
            "sessionID": "ses_2",
            "values": {
              "deploy": {
                "executionID": "exe_1",
                "seq": 2,
                "value": {
                  "function": "deploy"
                }
              }
            }
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "name": "deploy",
        "sessionID": "ses_2"
      }
    },
    {
      "description": "A fork has the commands its copy carries, not its parent's: one the copy left out is not the fork's.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "ses_1",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-command-defined",
          "examplePayload": {
            "description": "Deploy the app",
            "handler": "deploy",
            "name": "deploy",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_2",
            "slug": "ses_2",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-notebook-copied",
          "examplePayload": {
            "commands": {},
            "events": {},
            "sessionID": "ses_2",
            "values": {
              "deploy": {
                "executionID": "exe_1",
                "seq": 2,
                "value": {
                  "function": "deploy"
                }
              }
            }
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "command-not-found"
      },
      "when": {
        "name": "deploy",
        "sessionID": "ses_2"
      }
    },
    {
      "description": "A command the Session does not have is refused, and the host answers as done.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "ses_1",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-command-defined",
          "examplePayload": {
            "description": "Deploy the app",
            "handler": "deploy",
            "name": "deploy",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-command-removed",
          "examplePayload": {
            "name": "deploy",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "command-not-found"
      },
      "when": {
        "name": "deploy",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "An unknown Session is refused.",
      "expect": [],
      "given": [],
      "reject": {
        "code": "session-not-found"
      },
      "when": {
        "name": "deploy",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A deleted Session is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "ses_1",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-command-defined",
          "examplePayload": {
            "description": "Deploy the app",
            "handler": "deploy",
            "name": "deploy",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-deleted",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "session-deleted"
      },
      "when": {
        "name": "deploy",
        "sessionID": "ses_1"
      }
    }
  ]
}
