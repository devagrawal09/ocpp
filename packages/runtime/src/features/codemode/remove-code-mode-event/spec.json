{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Removes a scheduled event of a live Session. An event the Session does not have records nothing.",
  "formatVersion": 1,
  "kind": "command",
  "name": "removeCodeModeEvent",
  "scenarios": [
    {
      "description": "An event the Session defined is removed.",
      "expect": [
        {
          "eventType": "session-codemode-event-removed",
          "examplePayload": {
            "name": "nightly",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "ses_1",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-event-defined",
          "examplePayload": {
            "description": "Nightly report",
            "handler": "report",
            "name": "nightly",
            "next": 86400001,
            "schedule": {
              "every": "1d"
            },
            "sessionID": "ses_1",
            "time": 1
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "name": "nightly",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A fork's event, copied with its notebook, is the fork's own.",
      "expect": [
        {
          "eventType": "session-codemode-event-removed",
          "examplePayload": {
            "name": "nightly",
            "sessionID": "ses_2"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "ses_1",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-event-defined",
          "examplePayload": {
            "description": "Nightly report",
            "handler": "report",
            "name": "nightly",
            "next": 86400001,
            "schedule": {
              "every": "1d"
            },
            "sessionID": "ses_1",
            "time": 1
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_2",
            "slug": "ses_2",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-notebook-copied",
          "examplePayload": {
            "executions": [
              "exe_1"
            ],
            "parentID": "ses_1",
            "sessionID": "ses_2"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "name": "nightly",
        "sessionID": "ses_2"
      }
    },
    {
      "description": "An event the Session does not have is refused, and the host answers as done.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "ses_1",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-event-defined",
          "examplePayload": {
            "description": "Nightly report",
            "handler": "report",
            "name": "nightly",
            "next": 86400001,
            "schedule": {
              "every": "1d"
            },
            "sessionID": "ses_1",
            "time": 1
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-event-removed",
          "examplePayload": {
            "name": "nightly",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Event not found"
      },
      "when": {
        "name": "nightly",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "An unknown Session is refused.",
      "expect": [],
      "given": [],
      "reject": {
        "reason": "Session not found"
      },
      "when": {
        "name": "nightly",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A deleted Session is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "ses_1",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-event-defined",
          "examplePayload": {
            "description": "Nightly report",
            "handler": "report",
            "name": "nightly",
            "next": 86400001,
            "schedule": {
              "every": "1d"
            },
            "sessionID": "ses_1",
            "time": 1
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-deleted",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Session deleted"
      },
      "when": {
        "name": "nightly",
        "sessionID": "ses_1"
      }
    }
  ]
}
