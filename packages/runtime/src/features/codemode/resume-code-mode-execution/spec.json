{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Records that a running Code Mode execution resumed after its host restarted, replaying its journal. Only a running execution resumes.",
  "formatVersion": 1,
  "kind": "command",
  "name": "resumeCodeModeExecution",
  "scenarios": [
    {
      "description": "A running execution resumes.",
      "expect": [
        {
          "eventType": "session-codemode-execution-resumed",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-started",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "executionID": "exe_1"
      }
    },
    {
      "description": "An execution that never started is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Execution not running"
      },
      "when": {
        "executionID": "exe_1"
      }
    },
    {
      "description": "A settled execution is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-started",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-settled",
          "examplePayload": {
            "error": "Boom",
            "executionID": "exe_1",
            "outcome": "failed",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Execution not running"
      },
      "when": {
        "executionID": "exe_1"
      }
    },
    {
      "description": "An execution never admitted, or discarded, is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-discarded",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Execution not found"
      },
      "when": {
        "executionID": "exe_1"
      }
    }
  ]
}
