{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Records that a running Code Mode execution resumed after its host restarted, replaying its journal. Only a running execution resumes.",
  "formatVersion": 2,
  "kind": "command",
  "name": "resumeCodeModeExecution",
  "scenarios": [
    {
      "description": "A running execution resumes.",
      "expect": [
        {
          "eventType": "session-codemode-execution-resumed",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-started",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "executionID": "exe_1"
      }
    },
    {
      "description": "An execution that never started is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "execution-not-running"
      },
      "when": {
        "executionID": "exe_1"
      }
    },
    {
      "description": "A settled execution is forgotten: it is refused as unknown, which the host answers as done.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-started",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-settled",
          "examplePayload": {
            "error": "Boom",
            "executionID": "exe_1",
            "outcome": "failed",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "execution-not-found"
      },
      "when": {
        "executionID": "exe_1"
      }
    },
    {
      "description": "An execution never admitted, or discarded, is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-discarded",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "execution-not-found"
      },
      "when": {
        "executionID": "exe_1"
      }
    },
    {
      "description": "A deleted Session's execution is gone: its deletion settled it, and its tombstone forgets it.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-started",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-settled",
          "examplePayload": {
            "error": "The Session was deleted; nothing was saved.",
            "executionID": "exe_1",
            "outcome": "failed",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-deleted",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "execution-not-found"
      },
      "when": {
        "executionID": "exe_1"
      }
    }
  ]
}
