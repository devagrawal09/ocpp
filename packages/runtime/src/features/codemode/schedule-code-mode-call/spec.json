{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Journals a tool call a running Code Mode execution makes, before the tool runs, so a resumed run can replay it. A resumed run reaches calls that are journaled already: the first record of a call wins.",
  "formatVersion": 2,
  "kind": "command",
  "name": "scheduleCodeModeCall",
  "scenarios": [
    {
      "description": "A running execution's call is journaled.",
      "expect": [
        {
          "eventType": "session-codemode-call-scheduled",
          "examplePayload": {
            "executionID": "exe_1",
            "index": 0,
            "input": {
              "path": "a.txt"
            },
            "omitted": false,
            "sessionID": "ses_1",
            "tool": "read"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "await read()",
              "version": 1
            },
            "reserved": [],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-started",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "executionID": "exe_1",
        "index": 0,
        "input": {
          "path": "a.txt"
        },
        "omitted": false,
        "tool": "read"
      }
    },
    {
      "description": "The impure helper values the program read before the call are journaled with it.",
      "expect": [
        {
          "eventType": "session-codemode-call-scheduled",
          "examplePayload": {
            "executionID": "exe_1",
            "impure": [
              0.5
            ],
            "index": 1,
            "input": {
              "path": "a.txt"
            },
            "omitted": false,
            "sessionID": "ses_1",
            "tool": "read"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "await read()",
              "version": 1
            },
            "reserved": [],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-started",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "executionID": "exe_1",
        "impure": [
          0.5
        ],
        "index": 1,
        "input": {
          "path": "a.txt"
        },
        "omitted": false,
        "tool": "read"
      }
    },
    {
      "description": "A call journaled already is refused, and the host answers as done.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "await read()",
              "version": 1
            },
            "reserved": [],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-started",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-call-scheduled",
          "examplePayload": {
            "executionID": "exe_1",
            "index": 0,
            "input": {
              "path": "a.txt"
            },
            "omitted": false,
            "sessionID": "ses_1",
            "tool": "read"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "call-already-scheduled"
      },
      "when": {
        "executionID": "exe_1",
        "index": 0,
        "input": {
          "path": "a.txt"
        },
        "omitted": false,
        "tool": "read"
      }
    },
    {
      "description": "A settled execution is forgotten: its call is refused as unknown, which the host answers as done.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "await read()",
              "version": 1
            },
            "reserved": [],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-started",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-settled",
          "examplePayload": {
            "error": "Boom",
            "executionID": "exe_1",
            "outcome": "failed",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "execution-not-found"
      },
      "when": {
        "executionID": "exe_1",
        "index": 0,
        "input": {
          "path": "a.txt"
        },
        "omitted": false,
        "tool": "read"
      }
    },
    {
      "description": "An unknown execution is refused.",
      "expect": [],
      "given": [],
      "reject": {
        "code": "execution-not-found"
      },
      "when": {
        "executionID": "exe_1",
        "index": 0,
        "input": {
          "path": "a.txt"
        },
        "omitted": false,
        "tool": "read"
      }
    },
    {
      "description": "An execution that has not started journals nothing.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "await read()",
              "version": 1
            },
            "reserved": [],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "execution-not-running"
      },
      "when": {
        "executionID": "exe_1",
        "index": 0,
        "input": {
          "path": "a.txt"
        },
        "omitted": false,
        "tool": "read"
      }
    },
    {
      "description": "An execution discarded before it started is forgotten: its call is refused as unknown.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "await read()",
              "version": 1
            },
            "reserved": [],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-discarded",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "execution-not-found"
      },
      "when": {
        "executionID": "exe_1",
        "index": 0,
        "input": {
          "path": "a.txt"
        },
        "omitted": false,
        "tool": "read"
      }
    },
    {
      "description": "A deleted Session's execution is gone: its deletion settled it, and its tombstone forgets it.",
      "expect": [],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "await read()",
              "version": 1
            },
            "reserved": [],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-started",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-settled",
          "examplePayload": {
            "error": "The Session was deleted; nothing was saved.",
            "executionID": "exe_1",
            "outcome": "failed",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-deleted",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "execution-not-found"
      },
      "when": {
        "executionID": "exe_1",
        "index": 0,
        "input": {
          "path": "a.txt"
        },
        "omitted": false,
        "tool": "read"
      }
    }
  ]
}
