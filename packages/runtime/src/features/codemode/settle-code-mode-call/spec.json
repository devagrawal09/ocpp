            "input": {
              "path": "a.txt"
            },
            "omitted": false,
            "sessionID": "ses_1",
            "tool": "read"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-call-settled",
          "examplePayload": {
            "error": "Interrupted by shutdown",
            "executionID": "exe_1",
            "index": 0,
            "omitted": false,
            "outcome": "indeterminate",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "executionID": "exe_1",
        "index": 0,
        "omitted": false,
        "outcome": "completed",
        "output": "text"
      }
    },
