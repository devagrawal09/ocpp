{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Settles a journaled call of a running Code Mode execution: completed with its output, failed with its error, or indeterminate when a shutdown interrupted it. An indeterminate call settles again when a resumed run reaches it; a call that completed or failed settles once.",
  "formatVersion": 2,
  "kind": "command",
  "name": "settleCodeModeCall",
  "scenarios": [
    {
      "description": "A journaled call completes with its output.",
      "expect": [
        {
          "eventType": "session-codemode-call-settled",
          "examplePayload": {
            "executionID": "exe_1",
            "index": 0,
            "omitted": false,
            "outcome": "completed",
            "output": "text",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "await read()",
              "version": 1
            },
            "reserved": [],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-started",
          "examplePayload": {
            "executionID": "exe_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-call-scheduled",
          "examplePayload": {
            "executionID": "exe_1",
            "index": 0,
            "input": {
              "path": "a.txt"
            },
            "omitted": false,
            "sessionID": "ses_1",
            "tool": "read"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "executionID": "exe_1",
        "index": 0,
        "omitted": false,
        "outcome": "completed",
        "output": "text"
      }
    },
