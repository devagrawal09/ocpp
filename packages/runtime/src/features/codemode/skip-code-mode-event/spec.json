{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Records a firing of a live Session's event skipped because the previous one still runs.",
  "formatVersion": 2,
  "kind": "command",
  "name": "skipCodeModeEvent",
  "scenarios": [
    {
      "description": "An event the Session defined records a skipped firing.",
      "expect": [
        {
          "eventType": "session-codemode-event-skipped",
          "examplePayload": {
            "at": 86400001,
            "name": "nightly",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "ses_1",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-event-defined",
          "examplePayload": {
            "description": "Nightly report",
            "handler": "report",
            "name": "nightly",
            "next": 86400001,
            "schedule": {
              "every": "1d"
            },
            "sessionID": "ses_1",
            "time": 1
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "at": 86400001,
        "name": "nightly",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A fork's event, copied with its notebook, is the fork's own.",
      "expect": [
        {
          "eventType": "session-codemode-event-skipped",
          "examplePayload": {
            "at": 86400001,
            "name": "nightly",
            "sessionID": "ses_2"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "ses_1",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-event-defined",
          "examplePayload": {
            "description": "Nightly report",
            "handler": "report",
            "name": "nightly",
            "next": 86400001,
            "schedule": {
              "every": "1d"
            },
            "sessionID": "ses_1",
            "time": 1
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_2",
            "slug": "ses_2",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-notebook-copied",
          "examplePayload": {
            "executions": [
              "exe_1"
            ],
            "parentID": "ses_1",
            "sessionID": "ses_2"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "at": 86400001,
        "name": "nightly",
        "sessionID": "ses_2"
      }
    },
    {
      "description": "An event the Session does not have is refused, and the host answers as done.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "ses_1",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-event-defined",
          "examplePayload": {
            "description": "Nightly report",
            "handler": "report",
            "name": "nightly",
            "next": 86400001,
            "schedule": {
              "every": "1d"
            },
            "sessionID": "ses_1",
            "time": 1
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-event-removed",
          "examplePayload": {
            "name": "nightly",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "event-not-found"
      },
      "when": {
        "at": 86400001,
        "name": "nightly",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "An unknown Session is refused.",
      "expect": [],
      "given": [],
      "reject": {
        "code": "session-not-found"
      },
      "when": {
        "at": 86400001,
        "name": "nightly",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A deleted Session is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "ses_1",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-event-defined",
          "examplePayload": {
            "description": "Nightly report",
            "handler": "report",
            "name": "nightly",
            "next": 86400001,
            "schedule": {
              "every": "1d"
            },
            "sessionID": "ses_1",
            "time": 1
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-deleted",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "session-deleted"
      },
      "when": {
        "at": 86400001,
        "name": "nightly",
        "sessionID": "ses_1"
      }
    }
  ]
}
