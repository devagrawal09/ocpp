{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Records in a live Session that an admitted Code Mode execution went to the background, for the call or the invocation that owns it: its result arrives later. An execution starts this way once.",
  "formatVersion": 1,
  "kind": "command",
  "name": "startCodeMode",
  "scenarios": [
    {
      "description": "An admitted execution of the Session starts in the background.",
      "expect": [
        {
          "eventType": "session-codemode-started",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "id": "call_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "assistantMessageID": "msg_1",
        "executionID": "exe_1",
        "id": "call_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "An execution that started already is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-started",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "id": "call_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Code Mode already started"
      },
      "when": {
        "assistantMessageID": "msg_1",
        "executionID": "exe_1",
        "id": "call_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "An execution another Session admitted is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_2",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Execution not found"
      },
      "when": {
        "assistantMessageID": "msg_1",
        "executionID": "exe_1",
        "id": "call_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "An unknown Session is refused.",
      "expect": [],
      "given": [],
      "reject": {
        "reason": "Session not found"
      },
      "when": {
        "assistantMessageID": "msg_1",
        "executionID": "exe_1",
        "id": "call_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A deleted Session is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-codemode-execution-admitted",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executionID": "exe_1",
            "program": {
              "source": "const a = 1",
              "version": 1
            },
            "reserved": [
              "a"
            ],
            "sessionID": "ses_1",
            "snapshot": [],
            "toolCallID": "call_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-deleted",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Session deleted"
      },
      "when": {
        "assistantMessageID": "msg_1",
        "executionID": "exe_1",
        "id": "call_1",
        "sessionID": "ses_1"
      }
    }
  ]
}
