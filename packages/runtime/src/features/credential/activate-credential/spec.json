{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Switches an integration to one of its credentials: exactly one credential of an integration is the one it uses. The credential it uses already records nothing.",
  "formatVersion": 2,
  "kind": "command",
  "name": "activateCredential",
  "scenarios": [
    {
      "description": "An integration switches to an older credential.",
      "expect": [
        {
          "eventType": "credential-activated",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "cred_1",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_2",
            "integrationID": "anthropic",
            "label": "cred_2",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "credentialID": "cred_1"
      }
    },
    {
      "description": "The credential the integration uses is refused, and the host answers as done.",
      "expect": [],
      "given": [
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "cred_1",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_2",
            "integrationID": "anthropic",
            "label": "cred_2",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-activated",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "credential-already-active"
      },
      "when": {
        "credentialID": "cred_1"
      }
    },
    {
      "description": "The credential that replaced a removed one is the one in use.",
      "expect": [],
      "given": [
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "cred_1",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_2",
            "integrationID": "anthropic",
            "label": "cred_2",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-removed",
          "examplePayload": {
            "credentialID": "cred_2",
            "integrationID": "anthropic",
            "replacement": "cred_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "credential-already-active"
      },
      "when": {
        "credentialID": "cred_1"
      }
    },
    {
      "description": "An unknown credential is refused.",
      "expect": [],
      "given": [],
      "reject": {
        "code": "credential-not-found"
      },
      "when": {
        "credentialID": "cred_1"
      }
    },
    {
      "description": "A removed credential is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "cred_1",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-removed",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "credential-not-found"
      },
      "when": {
        "credentialID": "cred_1"
      }
    }
  ]
}
