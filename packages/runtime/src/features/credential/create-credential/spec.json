{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Stores a credential for an integration, with its secret sealed under a key of its own that the host keeps beside the log, and makes it the one the integration uses. A credential ID names one credential.",
  "formatVersion": 2,
  "kind": "command",
  "name": "createCredential",
  "scenarios": [
    {
      "description": "A new credential is stored and becomes the one its integration uses.",
      "expect": [
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "default",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        }
      ],
      "given": [],
      "when": {
        "credentialID": "cred_1",
        "integrationID": "anthropic",
        "label": "default",
        "secret": {
          "data": "c2VhbGVk",
          "iv": "aXY="
        }
      }
    },
    {
      "description": "A credential that exists is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "default",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "credential-already-exists"
      },
      "when": {
        "credentialID": "cred_1",
        "integrationID": "anthropic",
        "label": "default",
        "secret": {
          "data": "c2VhbGVk",
          "iv": "aXY="
        }
      }
    },
    {
      "description": "A removed credential's ID is gone with its key, and stores a credential again.",
      "expect": [
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "default",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "default",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-removed",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "credentialID": "cred_1",
        "integrationID": "anthropic",
        "label": "default",
        "secret": {
          "data": "c2VhbGVk",
          "iv": "aXY="
        }
      }
    }
  ]
}
