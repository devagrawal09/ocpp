{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Removes a credential with its secret; the host deletes its key with it. When the integration used it, the newest of its remaining credentials replaces it in the same commit, so an integration with credentials always uses one.",
  "formatVersion": 2,
  "kind": "command",
  "name": "removeCredential",
  "scenarios": [
    {
      "description": "A credential the integration does not use is removed alone.",
      "expect": [
        {
          "eventType": "credential-removed",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "cred_1",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_2",
            "integrationID": "anthropic",
            "label": "cred_2",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "credentialID": "cred_1"
      }
    },
    {
      "description": "The credential in use is replaced by the newest remaining one.",
      "expect": [
        {
          "eventType": "credential-removed",
          "examplePayload": {
            "credentialID": "cred_3",
            "integrationID": "anthropic",
            "replacement": "cred_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "cred_1",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_2",
            "integrationID": "anthropic",
            "label": "cred_2",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_3",
            "integrationID": "anthropic",
            "label": "cred_3",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-activated",
          "examplePayload": {
            "credentialID": "cred_3",
            "integrationID": "anthropic"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-removed",
          "examplePayload": {
            "credentialID": "cred_2",
            "integrationID": "anthropic"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "credentialID": "cred_3"
      }
    },
    {
      "description": "Another integration's credentials never replace it.",
      "expect": [
        {
          "eventType": "credential-removed",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "cred_1",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_2",
            "integrationID": "openai",
            "label": "cred_2",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "credentialID": "cred_1"
      }
    },
    {
      "description": "An unknown credential is refused, and the host answers as done.",
      "expect": [],
      "given": [],
      "reject": {
        "code": "credential-not-found"
      },
      "when": {
        "credentialID": "cred_1"
      }
    }
  ]
}
