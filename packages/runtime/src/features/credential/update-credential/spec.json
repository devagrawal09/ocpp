{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Changes a credential's label, its secret, or both in one commit. The host seals the new secret under the credential's own key. The label it has already, without a new secret, records nothing.",
  "formatVersion": 1,
  "kind": "command",
  "name": "updateCredential",
  "scenarios": [
    {
      "description": "A new label and a new secret are recorded together.",
      "expect": [
        {
          "eventType": "credential-relabeled",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "work"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-rotated",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "secret": {
              "data": "cm90YXRlZA==",
              "iv": "bmV3"
            }
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "default",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "credentialID": "cred_1",
        "label": "work",
        "secret": {
          "data": "cm90YXRlZA==",
          "iv": "bmV3"
        }
      }
    },
    {
      "description": "The label it has already is not recorded again; the secret still rotates.",
      "expect": [
        {
          "eventType": "credential-rotated",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "secret": {
              "data": "cm90YXRlZA==",
              "iv": "bmV3"
            }
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "default",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-relabeled",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "work"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "credentialID": "cred_1",
        "label": "work",
        "secret": {
          "data": "cm90YXRlZA==",
          "iv": "bmV3"
        }
      }
    },
    {
      "description": "A new label alone relabels it.",
      "expect": [
        {
          "eventType": "credential-relabeled",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "work"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "default",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "credentialID": "cred_1",
        "label": "work"
      }
    },
    {
      "description": "The label it has, and no secret, is refused, and the host answers as done.",
      "expect": [],
      "given": [
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "default",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-relabeled",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "work"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Credential unchanged"
      },
      "when": {
        "credentialID": "cred_1",
        "label": "work"
      }
    },
    {
      "description": "A removed credential is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "credential-created",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic",
            "label": "default",
            "secret": {
              "data": "c2VhbGVk",
              "iv": "aXY="
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "credential-removed",
          "examplePayload": {
            "credentialID": "cred_1",
            "integrationID": "anthropic"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Credential not found"
      },
      "when": {
        "credentialID": "cred_1",
        "label": "work"
      }
    }
  ]
}
