{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Removes the value a key of the key-value store holds. A key without a value records nothing.",
  "formatVersion": 2,
  "kind": "command",
  "name": "removeValue",
  "scenarios": [
    {
      "description": "A stored value is removed.",
      "expect": [
        {
          "eventType": "kv-removed",
          "examplePayload": {
            "key": "plugin:theme"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "kv-stored",
          "examplePayload": {
            "key": "plugin:theme",
            "value": {
              "mode": "dark"
            }
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "key": "plugin:theme"
      }
    },
    {
      "description": "A key that never held a value is refused, and the host answers as if it had removed it.",
      "expect": [],
      "given": [],
      "reject": {
        "code": "value-not-found"
      },
      "when": {
        "key": "plugin:theme"
      }
    },
    {
      "description": "A removed key is refused too.",
      "expect": [],
      "given": [
        {
          "eventType": "kv-stored",
          "examplePayload": {
            "key": "plugin:theme",
            "value": {
              "mode": "dark"
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "kv-removed",
          "examplePayload": {
            "key": "plugin:theme"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "value-not-found"
      },
      "when": {
        "key": "plugin:theme"
      }
    }
  ]
}
