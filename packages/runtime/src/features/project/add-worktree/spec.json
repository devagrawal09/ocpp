{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Records a worktree the host created for a project, with the strategy that manages it. A directory the project holds under the same strategy records nothing.",
  "formatVersion": 2,
  "kind": "command",
  "name": "addWorktree",
  "scenarios": [
    {
      "description": "A new directory of the project is recorded with its strategy.",
      "expect": [
        {
          "eventType": "worktree-recorded",
          "examplePayload": {
            "directory": "/repo/feature",
            "projectID": "prj_1",
            "strategy": "git"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "project-created",
          "examplePayload": {
            "canonical": "/repo",
            "projectID": "prj_1",
            "vcs": "git"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "directory": "/repo/feature",
        "projectID": "prj_1",
        "strategy": "git"
      }
    },
    {
      "description": "A directory the project holds under the same strategy is refused, and the host answers as done.",
      "expect": [],
      "given": [
        {
          "eventType": "project-created",
          "examplePayload": {
            "canonical": "/repo",
            "projectID": "prj_1",
            "vcs": "git"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "worktree-recorded",
          "examplePayload": {
            "directory": "/repo/feature",
            "projectID": "prj_1",
            "strategy": "git"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "worktree-unchanged"
      },
      "when": {
        "directory": "/repo/feature",
        "projectID": "prj_1",
        "strategy": "git"
      }
    },
    {
      "description": "A directory the project holds under another strategy is recorded again.",
      "expect": [
        {
          "eventType": "worktree-recorded",
          "examplePayload": {
            "directory": "/repo/feature",
            "projectID": "prj_1",
            "strategy": "git"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "project-created",
          "examplePayload": {
            "canonical": "/repo",
            "projectID": "prj_1",
            "vcs": "git"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "worktree-recorded",
          "examplePayload": {
            "directory": "/repo/feature",
            "projectID": "prj_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "directory": "/repo/feature",
        "projectID": "prj_1",
        "strategy": "git"
      }
    },
    {
      "description": "A directory the project no longer holds is recorded again.",
      "expect": [
        {
          "eventType": "worktree-recorded",
          "examplePayload": {
            "directory": "/repo/feature",
            "projectID": "prj_1",
            "strategy": "git"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "project-created",
          "examplePayload": {
            "canonical": "/repo",
            "projectID": "prj_1",
            "vcs": "git"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "worktree-recorded",
          "examplePayload": {
            "directory": "/repo/feature",
            "projectID": "prj_1",
            "strategy": "git"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "worktree-removed",
          "examplePayload": {
            "directory": "/repo/feature",
            "projectID": "prj_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "directory": "/repo/feature",
        "projectID": "prj_1",
        "strategy": "git"
      }
    },
    {
      "description": "A directory of an unknown project is refused.",
      "expect": [],
      "given": [],
      "reject": {
        "code": "project-not-found"
      },
      "when": {
        "directory": "/repo/feature",
        "projectID": "prj_1",
        "strategy": "git"
      }
    }
  ]
}
