{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Records a project as a directory resolved to it: its creation the first time, then what changed since. A project's version control may change or go away. Clones share a project ID, so a project moves to another canonical directory only when the host found the one it has gone. Nothing changed records nothing.",
  "formatVersion": 2,
  "kind": "command",
  "name": "resolveProject",
  "scenarios": [
    {
      "description": "A new project is created at its canonical directory, with its version control.",
      "expect": [
        {
          "eventType": "project-created",
          "examplePayload": {
            "canonical": "/repo",
            "projectID": "prj_1",
            "vcs": "git"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [],
      "when": {
        "canonical": "/repo",
        "projectID": "prj_1",
        "vcs": "git"
      }
    },
    {
      "description": "A project without version control is created without it.",
      "expect": [
        {
          "eventType": "project-created",
          "examplePayload": {
            "canonical": "/repo",
            "projectID": "prj_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [],
      "when": {
        "canonical": "/repo",
        "projectID": "prj_1"
      }
    },
    {
      "description": "A project resolved as it is recorded is refused, and the host answers as done.",
      "expect": [],
      "given": [
        {
          "eventType": "project-created",
          "examplePayload": {
            "canonical": "/repo",
            "projectID": "prj_1",
            "vcs": "git"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "project-unchanged"
      },
      "when": {
        "canonical": "/repo",
        "projectID": "prj_1",
        "vcs": "git"
      }
    },
    {
      "description": "Another version control is recorded.",
      "expect": [
        {
          "eventType": "project-vcs-changed",
          "examplePayload": {
            "projectID": "prj_1",
            "vcs": "hg"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "project-created",
          "examplePayload": {
            "canonical": "/repo",
            "projectID": "prj_1",
            "vcs": "git"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "canonical": "/repo",
        "projectID": "prj_1",
        "vcs": "hg"
      }
    },
    {
      "description": "Version control that went away is recorded as none.",
      "expect": [
        {
          "eventType": "project-vcs-changed",
          "examplePayload": {
            "projectID": "prj_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "project-created",
          "examplePayload": {
            "canonical": "/repo",
            "projectID": "prj_1",
            "vcs": "git"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "canonical": "/repo",
        "projectID": "prj_1"
      }
    },
    {
      "description": "A project whose canonical directory the host found gone moves to the one it resolved.",
      "expect": [
        {
          "eventType": "project-relocated",
          "examplePayload": {
            "canonical": "/moved",
            "projectID": "prj_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "project-created",
          "examplePayload": {
            "canonical": "/repo",
            "projectID": "prj_1",
            "vcs": "git"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "canonical": "/moved",
        "missing": "/repo",
        "projectID": "prj_1",
        "vcs": "git"
      }
    },
    {
      "description": "A clone elsewhere keeps the canonical directory, which still exists.",
      "expect": [],
      "given": [
        {
          "eventType": "project-created",
          "examplePayload": {
            "canonical": "/repo",
            "projectID": "prj_1",
            "vcs": "git"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "project-unchanged"
      },
      "when": {
        "canonical": "/clone",
        "projectID": "prj_1",
        "vcs": "git"
      }
    },
    {
      "description": "A directory the host found gone that the project no longer has moves nothing.",
      "expect": [],
      "given": [
        {
          "eventType": "project-created",
          "examplePayload": {
            "canonical": "/repo",
            "projectID": "prj_1",
            "vcs": "git"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "project-relocated",
          "examplePayload": {
            "canonical": "/moved",
            "projectID": "prj_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "project-unchanged"
      },
      "when": {
        "canonical": "/clone",
        "missing": "/repo",
        "projectID": "prj_1",
        "vcs": "git"
      }
    },
    {
      "description": "A change of version control and a move are one commit.",
      "expect": [
        {
          "eventType": "project-vcs-changed",
          "examplePayload": {
            "projectID": "prj_1",
            "vcs": "git"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "project-relocated",
          "examplePayload": {
            "canonical": "/moved",
            "projectID": "prj_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "project-created",
          "examplePayload": {
            "canonical": "/repo",
            "projectID": "prj_1",
            "vcs": "git"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "project-vcs-changed",
          "examplePayload": {
            "projectID": "prj_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "canonical": "/moved",
        "missing": "/repo",
        "projectID": "prj_1",
        "vcs": "git"
      }
    }
  ]
}
