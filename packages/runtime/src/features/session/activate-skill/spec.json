{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Activates a skill in a live Session: its text enters the Session's history.",
  "formatVersion": 2,
  "kind": "command",
  "name": "activateSkill",
  "scenarios": [
    {
      "description": "The skill's text enters the Session.",
      "expect": [
        {
          "eventType": "session-skill-activated",
          "examplePayload": {
            "id": "effect",
            "name": "Effect",
            "sessionID": "ses_1",
            "text": "Use Effect"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "id": "effect",
        "name": "Effect",
        "sessionID": "ses_1",
        "text": "Use Effect"
      }
    },
    {
      "description": "An unknown Session is refused.",
      "expect": [],
      "given": [],
      "reject": {
        "code": "session-not-found"
      },
      "when": {
        "id": "effect",
        "name": "Effect",
        "sessionID": "ses_1",
        "text": "Use Effect"
      }
    },
    {
      "description": "A deleted Session is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-deleted",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "session-deleted"
      },
      "when": {
        "id": "effect",
        "name": "Effect",
        "sessionID": "ses_1",
        "text": "Use Effect"
      }
    }
  ]
}
