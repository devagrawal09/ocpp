{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Appends a synthetic message to a live Session's history directly, not through its inbox: instructions a tool loaded, or a notice that the turn goes on (after an incomplete stream or a restart).",
  "formatVersion": 2,
  "kind": "command",
  "name": "appendSynthetic",
  "scenarios": [
    {
      "description": "The message enters the Session's history.",
      "expect": [
        {
          "eventType": "session-synthetic",
          "examplePayload": {
            "description": "Continuing after restart",
            "sessionID": "ses_1",
            "text": "Continue from where you left off."
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "description": "Continuing after restart",
        "sessionID": "ses_1",
        "text": "Continue from where you left off."
      }
    },
    {
      "description": "An unknown Session is refused.",
      "expect": [],
      "given": [],
      "reject": {
        "code": "session-not-found"
      },
      "when": {
        "description": "Continuing after restart",
        "sessionID": "ses_1",
        "text": "Continue from where you left off."
      }
    },
    {
      "description": "A deleted Session is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-deleted",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "session-deleted"
      },
      "when": {
        "description": "Continuing after restart",
        "sessionID": "ses_1",
        "text": "Continue from where you left off."
      }
    }
  ]
}
