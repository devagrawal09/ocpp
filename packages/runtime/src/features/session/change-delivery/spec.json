              "payload": {
                "text": "later"
              },
              "type": "user"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-delivered",
          "examplePayload": {
            "inboxID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "inbox-item-not-pending"
      },
      "when": {
        "delivery": "steer",
        "inboxID": "msg_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "Cancelled input is no longer pending.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
