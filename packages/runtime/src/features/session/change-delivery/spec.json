        "delivery": "steer",
        "inboxID": "msg_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "An unknown item, or one admitted to another Session, is not found.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_2",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "queue",
              "payload": {
                "text": "later"
              },
              "type": "user"
            },
            "sessionID": "ses_2"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "inbox-item-not-found"
      },
      "when": {
        "delivery": "steer",
        "inboxID": "msg_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "An unknown Session is refused.",
      "expect": [],
      "given": [],
      "reject": {
        "code": "session-not-found"
      },
      "when": {
        "delivery": "steer",
        "inboxID": "msg_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A deleted Session is refused; deleting it cancelled its pending input.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
