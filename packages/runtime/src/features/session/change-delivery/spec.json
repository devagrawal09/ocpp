{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Changes how a pending inbox item is delivered (session.md: steer and queue): a steered item enters history at the next step boundary, a queued one waits for idle.",
  "formatVersion": 2,
  "kind": "command",
  "name": "changeDelivery",
  "scenarios": [
    {
      "description": "A queued item is steered.",
      "expect": [
        {
          "eventType": "session-inbox-delivery-changed",
          "examplePayload": {
            "delivery": "steer",
            "inboxID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "queue",
              "payload": {
                "text": "later"
              },
              "type": "user"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "delivery": "steer",
        "inboxID": "msg_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A steered item is queued.",
      "expect": [
        {
          "eventType": "session-inbox-delivery-changed",
          "examplePayload": {
            "delivery": "queue",
            "inboxID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "steer",
              "payload": {
                "text": "later"
              },
              "type": "user"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "delivery": "queue",
        "inboxID": "msg_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "An item can change back after an earlier change.",
      "expect": [
        {
          "eventType": "session-inbox-delivery-changed",
          "examplePayload": {
            "delivery": "queue",
            "inboxID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "queue",
              "payload": {
                "text": "later"
              },
              "type": "user"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-delivery-changed",
          "examplePayload": {
            "delivery": "steer",
            "inboxID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "delivery": "queue",
        "inboxID": "msg_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "An item already delivered that way is rejected.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "steer",
              "payload": {
                "text": "later"
              },
              "type": "user"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "inbox-delivery-unchanged",
        "message": "Inbox item already steer"
      },
      "when": {
        "delivery": "steer",
        "inboxID": "msg_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "Delivered input is no longer pending.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
