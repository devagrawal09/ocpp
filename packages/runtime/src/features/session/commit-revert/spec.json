{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Commits the revert staged in an idle Session: its history is cut at the staged message. Input still pending belongs to the history it cuts away (a revert holds new notices while it is staged), so the commit cancels it in the same commit; the next input starts the new history.",
  "formatVersion": 1,
  "kind": "command",
  "name": "commitRevert",
  "scenarios": [
    {
      "description": "The staged revert is committed to its message.",
      "expect": [
        {
          "eventType": "session-revert-committed",
          "examplePayload": {
            "sessionID": "ses_1",
            "to": "msg_2"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "files": [],
              "messageID": "msg_2"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "Every input still pending is cancelled first, in the order it was admitted, in the same commit.",
      "expect": [
        {
          "eventType": "session-inbox-cancelled",
          "examplePayload": {
            "inboxID": "msg_3",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-cancelled",
          "examplePayload": {
            "inboxID": "msg_4",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-committed",
          "examplePayload": {
            "sessionID": "ses_1",
            "to": "msg_2"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "steer",
              "payload": {
                "text": "Notice msg_1"
              },
              "type": "synthetic"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-delivered",
          "examplePayload": {
            "inboxID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "files": [],
              "messageID": "msg_2"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_3",
            "item": {
              "delivery": "queue",
              "payload": {
                "text": "Notice msg_3"
              },
              "type": "synthetic"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_4",
            "item": {
              "delivery": "steer",
              "payload": {
                "text": "Notice msg_4"
              },
              "type": "synthetic"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_5",
            "item": {
              "delivery": "steer",
              "payload": {
                "text": "Notice msg_5"
              },
              "type": "synthetic"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-cancelled",
          "examplePayload": {
            "inboxID": "msg_5",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A Session whose execution has settled is idle again.",
      "expect": [
        {
          "eventType": "session-revert-committed",
          "examplePayload": {
            "sessionID": "ses_1",
            "to": "msg_2"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "files": [],
              "messageID": "msg_2"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-settled",
          "examplePayload": {
            "outcome": "succeeded",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "Nothing is staged: there is nothing to commit, and the host answers as if it had committed it.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "No revert staged"
      },
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A cleared revert is no longer staged.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "files": [],
              "messageID": "msg_2"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-cleared",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "No revert staged"
      },
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A committed revert is no longer staged.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "files": [],
              "messageID": "msg_2"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-committed",
          "examplePayload": {
            "sessionID": "ses_1",
            "to": "msg_2"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "No revert staged"
      },
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A running Session cannot commit its revert: the history would be cut under its step.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "files": [],
              "messageID": "msg_2"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Session is busy"
      },
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "An unknown Session is refused.",
      "expect": [],
      "given": [],
      "reject": {
        "reason": "Session not found"
      },
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A deleted Session is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "files": [],
              "messageID": "msg_2"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-deleted",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Session deleted"
      },
      "when": {
        "sessionID": "ses_1"
      }
    }
  ]
}
