{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Deletes a Session. Nothing of it runs or waits afterwards: in the same commit, an active execution is interrupted as the user's interruption settles it (its open tool calls and in-flight step aborted), every input still pending is cancelled, so nothing wakes it again, and every Code Mode execution still admitted or running fails, and every background job marker it owns completes. Its deletion is the tombstone its purge keeps. The host deletes its children first.",
  "formatVersion": 2,
  "kind": "command",
  "name": "deleteSession",
  "scenarios": [
    {
      "description": "An idle Session with nothing pending is deleted.",
      "expect": [
        {
          "eventType": "session-deleted",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-settled",
          "examplePayload": {
            "outcome": "succeeded",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1"
      }
    },
