            "outcome": "succeeded",
            "sessionID": "ses_1",
            "tokens": {
              "cache": {
                "read": 0,
                "write": 0
              },
              "input": 0,
              "output": 0,
              "reasoning": 0
            }
          },
          "kind": "scenario-event"
