            "model": {
              "id": "scripted",
              "providerID": "test"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-settled",
          "examplePayload": {
            "outcome": "interrupted",
            "reason": "user",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Execution not active"
      },
      "when": {
        "assistantMessageID": "msg_1",
        "error": {
          "message": "Tool call arguments were malformed JSON and were not executed. Retry with valid JSON.",
          "type": "tool.input-json"
        },
        "id": "call_1",
        "name": "echo",
        "sessionID": "ses_1"
      }
    }
  ]
}
