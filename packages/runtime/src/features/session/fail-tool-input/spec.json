              "type": "tool.input-json"
            },
            "executed": false,
            "id": "call_1",
            "name": "echo",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Tool call already recorded"
      },
      "when": {
        "assistantMessageID": "msg_1",
        "error": {
          "message": "Tool call arguments were malformed JSON and were not executed. Retry with valid JSON.",
          "type": "tool.input-json"
        },
        "id": "call_1",
        "name": "echo",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A settled step records no more calls.",
      "expect": [],
      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-started",
          "examplePayload": {
            "agent": "build",
