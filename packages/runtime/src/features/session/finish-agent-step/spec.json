            "assistantMessageID": "msg_a1",
            "kind": "reasoning",
            "ordinal": 0,
            "sessionID": "ses_1",
            "text": "Thinking"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-block-recorded",
          "examplePayload": {
            "assistantMessageID": "msg_a1",
            "kind": "text",
            "ordinal": 0,
            "sessionID": "ses_1",
