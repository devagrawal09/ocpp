{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Finishes the step an external agent produced, in one commit: its finished blocks, a failure for each call the agent left without a result, and the step's settlement with what it spent. The agent's own failure settles only the step: the host decides whether its execution goes on. Only the step in flight in a running execution finishes.",
  "formatVersion": 1,
  "kind": "command",
  "name": "finishAgentStep",
