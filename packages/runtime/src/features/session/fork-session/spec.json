{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Forks a live Session: the child's creation and the fork are recorded in one commit, so the child exists exactly when its fork does. The host resolves the boundary to a message of the parent's history and chooses the child's identity, and gives what the child inherits of its parent's projection: its settled messages through the boundary, the notebook values they saved with the parent's commands and events, its newest instruction values with the values they refer to, its instruction entries and its tool list. The fork records all of it, before session-forked, so nothing of the child reads its parent's facts: its history in pages of at most the bytes the host gives, and its notebook with the commands and events whose handler it holds.",
  "formatVersion": 2,
  "kind": "command",
  "name": "forkSession",
  "scenarios": [
    {
      "description": "The child is created and forked from its parent at the boundary, in one commit.",
      "expect": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_2",
            "slug": "calm-heron",
            "title": "Plan (fork #1)",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-forked",
          "examplePayload": {
            "boundary": {
              "messageID": "msg_3",
              "type": "through"
            },
            "parentID": "ses_1",
            "sessionID": "ses_2"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "title": "Plan",
            "version": "2"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "boundary": {
          "messageID": "msg_3",
          "type": "through"
        },
        "parentID": "ses_1",
        "session": {
          "location": {
            "directory": "/tmp/ws"
          },
          "projectID": "prj_1",
          "sessionID": "ses_2",
          "slug": "calm-heron",
          "title": "Plan (fork #1)",
          "version": "2"
        }
      }
    },
