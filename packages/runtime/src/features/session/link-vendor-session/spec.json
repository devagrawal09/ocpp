{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Links a live Session bound to an external agent to the vendor session that continues it. Linking the vendor session it has changes nothing; binding again unlinks it.",
  "formatVersion": 2,
  "kind": "command",
  "name": "linkVendorSession",
  "scenarios": [
    {
      "description": "A bound Session is linked to its vendor session.",
      "expect": [
        {
          "eventType": "session-external-linked",
          "examplePayload": {
            "sessionID": "ses_1",
            "vendorSessionID": "vendor_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-external-bound",
          "examplePayload": {
            "directory": "/tmp/ws",
            "provider": "claude",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1",
        "vendorSessionID": "vendor_1"
      }
    },
    {
      "description": "A new vendor session replaces the linked one.",
      "expect": [
        {
          "eventType": "session-external-linked",
          "examplePayload": {
            "sessionID": "ses_1",
            "vendorSessionID": "vendor_2"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-external-bound",
          "examplePayload": {
            "directory": "/tmp/ws",
            "provider": "claude",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-external-linked",
          "examplePayload": {
            "sessionID": "ses_1",
            "vendorSessionID": "vendor_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1",
        "vendorSessionID": "vendor_2"
      }
    },
    {
      "description": "The vendor session the Session has is refused: there is nothing to change.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-external-bound",
          "examplePayload": {
            "directory": "/tmp/ws",
            "provider": "claude",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-external-linked",
          "examplePayload": {
            "sessionID": "ses_1",
            "vendorSessionID": "vendor_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "vendor-session-already-linked"
      },
      "when": {
        "sessionID": "ses_1",
        "vendorSessionID": "vendor_1"
      }
    },
    {
      "description": "Binding again unlinks the vendor session, so linking it again records it.",
      "expect": [
        {
          "eventType": "session-external-linked",
          "examplePayload": {
            "sessionID": "ses_1",
            "vendorSessionID": "vendor_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-external-bound",
          "examplePayload": {
            "directory": "/tmp/ws",
            "provider": "claude",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-external-linked",
          "examplePayload": {
            "sessionID": "ses_1",
            "vendorSessionID": "vendor_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-external-bound",
          "examplePayload": {
            "directory": "/tmp/ws",
            "provider": "claude",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1",
        "vendorSessionID": "vendor_1"
      }
    },
    {
      "description": "A Session that no external agent runs is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "external-agent-not-bound"
      },
      "when": {
        "sessionID": "ses_1",
        "vendorSessionID": "vendor_1"
      }
    },
    {
      "description": "An unknown Session is refused.",
      "expect": [],
      "given": [],
      "reject": {
        "code": "session-not-found"
      },
      "when": {
        "sessionID": "ses_1",
        "vendorSessionID": "vendor_1"
      }
    },
    {
      "description": "A deleted Session is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-external-bound",
          "examplePayload": {
            "directory": "/tmp/ws",
            "provider": "claude",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-deleted",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "session-deleted"
      },
      "when": {
        "sessionID": "ses_1",
        "vendorSessionID": "vendor_1"
      }
    }
  ]
}
