{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Moves a Session now, for one that cannot run where it is (its directory is gone). A move that can wait is admitted to the inbox as a control item instead (enqueueInput) and moves the Session when it is delivered. Moving now supersedes the moves waiting in the inbox: they are cancelled in the same commit.",
  "formatVersion": 1,
  "kind": "command",
  "name": "moveSession",
  "scenarios": [
    {
      "description": "The Session moves to the destination at once.",
      "expect": [
        {
          "eventType": "session-moved",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "subpath": "app"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/gone"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "location": {
          "directory": "/tmp/ws"
        },
        "projectID": "prj_1",
        "sessionID": "ses_1",
        "subpath": "app"
      }
    },
    {
      "description": "Every move still waiting in the inbox is cancelled first, in admission order; other input stays.",
      "expect": [
        {
          "eventType": "session-inbox-cancelled",
          "examplePayload": {
            "inboxID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-cancelled",
          "examplePayload": {
            "inboxID": "msg_3",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-moved",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "subpath": "app"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/gone"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "steer",
              "payload": {
                "location": {
                  "directory": "/elsewhere/msg_1"
                },
                "projectID": "prj_1"
              },
              "type": "move"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_2",
            "item": {
              "delivery": "steer",
              "payload": {
                "text": "hello"
              },
              "type": "user"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_3",
            "item": {
              "delivery": "steer",
              "payload": {
                "location": {
                  "directory": "/elsewhere/msg_3"
                },
                "projectID": "prj_1"
              },
              "type": "move"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "location": {
          "directory": "/tmp/ws"
        },
        "projectID": "prj_1",
        "sessionID": "ses_1",
        "subpath": "app"
      }
    },
    {
      "description": "A move that was delivered or cancelled is no longer waiting.",
      "expect": [
        {
          "eventType": "session-moved",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "subpath": "app"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/gone"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "steer",
              "payload": {
                "location": {
                  "directory": "/elsewhere/msg_1"
                },
                "projectID": "prj_1"
              },
              "type": "move"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-delivered",
          "examplePayload": {
            "inboxID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_2",
            "item": {
              "delivery": "steer",
              "payload": {
                "location": {
                  "directory": "/elsewhere/msg_2"
                },
                "projectID": "prj_1"
              },
              "type": "move"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-cancelled",
          "examplePayload": {
            "inboxID": "msg_2",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "location": {
          "directory": "/tmp/ws"
        },
        "projectID": "prj_1",
        "sessionID": "ses_1",
        "subpath": "app"
      }
    },
    {
      "description": "An unknown Session is refused.",
      "expect": [],
      "given": [],
      "reject": {
        "reason": "Session not found"
      },
      "when": {
        "location": {
          "directory": "/tmp/ws"
        },
        "projectID": "prj_1",
        "sessionID": "ses_1",
        "subpath": "app"
      }
    },
    {
      "description": "A deleted Session is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/gone"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-deleted",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Session deleted"
      },
      "when": {
        "location": {
          "directory": "/tmp/ws"
        },
        "projectID": "prj_1",
        "sessionID": "ses_1",
        "subpath": "app"
      }
    }
  ]
}
