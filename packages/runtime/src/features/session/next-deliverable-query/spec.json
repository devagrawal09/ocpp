        "item": {
          "delivery": "queue",
          "inboxID": "msg_1",
          "type": "compaction"
        },
        "reason": "entry-control"
      },
      "given": [
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "queue",
              "payload": {},
              "type": "compaction"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_2",
            "item": {
              "delivery": "queue",
              "payload": {
                "text": "Later"
              },
              "type": "user"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "boundary": "entry",
        "sessionID": "ses_1"
      }
    },
