{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Records that a step began inside an active execution (session.md: One Step May Have Several Physical Attempts).",
  "formatVersion": 1,
  "kind": "command",
  "name": "recordStepStarted",
  "scenarios": [
    {
      "description": "An active execution starts its first step.",
      "expect": [
        {
          "eventType": "session-step-started",
          "examplePayload": {
            "agent": "build",
            "assistantMessageID": "msg_1",
            "model": {
              "id": "scripted",
              "providerID": "test"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "agent": "build",
        "assistantMessageID": "msg_1",
        "model": {
          "id": "scripted",
          "providerID": "test"
        },
        "sessionID": "ses_1"
      }
    },
    {
      "description": "The snapshot taken at the step boundary is recorded with the step.",
      "expect": [
        {
          "eventType": "session-step-started",
          "examplePayload": {
            "agent": "build",
            "assistantMessageID": "msg_1",
            "model": {
              "id": "scripted",
              "providerID": "test"
            },
            "sessionID": "ses_1",
            "snapshot": "snap_1"
          },
          "kind": "scenario-event"
        }
