      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "agent": "build",
        "assistantMessageID": "msg_1",
        "model": {
          "id": "scripted",
          "providerID": "test"
        },
        "sessionID": "ses_1",
        "snapshot": "snap_1"
      }
    },
    {
      "description": "A next step starts once the previous step has ended.",
