          "examplePayload": {
            "agent": "build",
            "assistantMessageID": "msg_1",
            "model": {
              "id": "scripted",
              "providerID": "test"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-started",
          "examplePayload": {
            "agent": "build",
            "assistantMessageID": "msg_1",
            "model": {
              "id": "scripted",
              "providerID": "test"
            },
            "sessionID": "ses_1"
