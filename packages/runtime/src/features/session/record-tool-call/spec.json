{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Records a complete local tool call of the in-flight step before any side effect (session.md: tool-call durability).",
  "formatVersion": 1,
  "kind": "command",
  "name": "recordToolCall",
  "scenarios": [
    {
      "description": "A tool call is recorded with its decoded input, not yet executed.",
      "expect": [
        {
          "eventType": "session-tool-requested",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executed": false,
            "id": "call_1",
            "input": {
              "code": "return 1"
            },
            "name": "execute",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-started",
          "examplePayload": {
            "agent": "build",
            "assistantMessageID": "msg_1",
            "model": {
              "id": "scripted",
              "providerID": "test"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "assistantMessageID": "msg_1",
        "id": "call_1",
        "input": {
          "code": "return 1"
        },
        "name": "execute",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "The tool name is recorded with the call.",
      "expect": [
        {
          "eventType": "session-tool-requested",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executed": false,
            "id": "call_1",
            "input": {
              "code": "x"
            },
            "name": "lookup",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
