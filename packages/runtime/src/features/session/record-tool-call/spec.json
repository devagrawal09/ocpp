      "description": "A call the provider executes itself is recorded as executed, with its provider state.",
      "expect": [
        {
          "eventType": "session-tool-requested",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executed": true,
            "id": "call_1",
            "input": {
              "query": "x"
            },
            "name": "web_search",
            "sessionID": "ses_1",
            "state": {
              "openai": {
                "itemID": "ws_1"
              }
            }
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-execution-started",
