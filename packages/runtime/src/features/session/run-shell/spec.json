{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Records a user's shell command running in a live Session, once the host has started it: the shell's timeline entry starts here and settles with settleShell. A shell runs once.",
  "formatVersion": 1,
  "kind": "command",
  "name": "runShell",
  "scenarios": [
    {
      "description": "The shell the host started runs in the Session.",
      "expect": [
        {
          "eventType": "session-shell-started",
          "examplePayload": {
            "sessionID": "ses_1",
            "shell": {
              "command": "pwd",
              "cwd": "/tmp/ws",
              "file": "/tmp/sh_1.out",
              "id": "sh_1",
              "metadata": {
                "background": true,
                "sessionID": "ses_1"
              },
              "shell": "/bin/sh",
              "status": "running",
              "time": {
                "started": 1
              }
            }
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1",
        "shell": {
          "command": "pwd",
          "cwd": "/tmp/ws",
          "file": "/tmp/sh_1.out",
          "id": "sh_1",
          "metadata": {
            "background": true,
            "sessionID": "ses_1"
          },
          "shell": "/bin/sh",
          "status": "running",
          "time": {
            "started": 1
          }
        }
      }
    },
    {
      "description": "A shell that is already running is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-shell-started",
          "examplePayload": {
            "sessionID": "ses_1",
            "shell": {
              "command": "pwd",
              "cwd": "/tmp/ws",
              "file": "/tmp/sh_1.out",
              "id": "sh_1",
              "metadata": {
                "background": true,
                "sessionID": "ses_1"
              },
              "shell": "/bin/sh",
              "status": "running",
              "time": {
                "started": 1
              }
            }
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Shell already started"
      },
      "when": {
        "sessionID": "ses_1",
        "shell": {
          "command": "pwd",
          "cwd": "/tmp/ws",
          "file": "/tmp/sh_1.out",
          "id": "sh_1",
          "metadata": {
            "background": true,
            "sessionID": "ses_1"
          },
          "shell": "/bin/sh",
          "status": "running",
          "time": {
            "started": 1
          }
        }
      }
    },
    {
      "description": "A shell that has settled is refused too: its ID names one run.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-shell-started",
          "examplePayload": {
            "sessionID": "ses_1",
            "shell": {
              "command": "pwd",
              "cwd": "/tmp/ws",
              "file": "/tmp/sh_1.out",
              "id": "sh_1",
              "metadata": {
                "background": true,
                "sessionID": "ses_1"
              },
              "shell": "/bin/sh",
              "status": "running",
              "time": {
                "started": 1
              }
            }
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-shell-settled",
          "examplePayload": {
            "exit": 0,
            "outcome": "exited",
            "output": {
              "cursor": 7,
              "output": "/tmp/ws",
              "size": 7,
              "truncated": false
            },
            "sessionID": "ses_1",
            "shellID": "sh_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Shell already started"
      },
      "when": {
        "sessionID": "ses_1",
        "shell": {
          "command": "pwd",
          "cwd": "/tmp/ws",
          "file": "/tmp/sh_1.out",
          "id": "sh_1",
          "metadata": {
            "background": true,
            "sessionID": "ses_1"
          },
          "shell": "/bin/sh",
          "status": "running",
          "time": {
            "started": 1
          }
        }
      }
    },
    {
      "description": "An unknown Session is refused.",
      "expect": [],
      "given": [],
      "reject": {
        "reason": "Session not found"
      },
      "when": {
        "sessionID": "ses_1",
        "shell": {
          "command": "pwd",
          "cwd": "/tmp/ws",
          "file": "/tmp/sh_1.out",
          "id": "sh_1",
          "metadata": {
            "background": true,
            "sessionID": "ses_1"
          },
          "shell": "/bin/sh",
          "status": "running",
          "time": {
            "started": 1
          }
        }
      }
    },
    {
      "description": "A deleted Session is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-deleted",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Session deleted"
      },
      "when": {
        "sessionID": "ses_1",
        "shell": {
          "command": "pwd",
          "cwd": "/tmp/ws",
          "file": "/tmp/sh_1.out",
          "id": "sh_1",
          "metadata": {
            "background": true,
            "sessionID": "ses_1"
          },
          "shell": "/bin/sh",
          "status": "running",
          "time": {
            "started": 1
          }
        }
      }
    }
  ]
}
