{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Records the single terminal fact of one physical attempt of an in-flight step (session.md: One Step May Have Several Physical Attempts: \"Every local and hosted call reaches durable success or failure before the Step publishes its single terminal ended or failed event\"). A success records its finish reason and usage. A failure records, in the same fact, whether the step is retried; which failures are retryable is the caller's classification, while this Command owns the budget (limit, default 3) and fails the execution in the same commit once it is spent.",
  "formatVersion": 1,
  "kind": "command",
  "name": "settleStep",
  "scenarios": [
    {
      "description": "A fresh retry runs as a new step because the failed attempt's output stands; the new step keeps the retry budget the first one spent.",
      "expect": [
        {
          "eventType": "session-step-settled",
          "examplePayload": {
            "assistantMessageID": "msg_2",
            "error": {
              "message": "connection reset",
              "type": "transport"
            },
            "outcome": "failed",
            "retry": {
              "at": 2000,
              "attempt": 2,
              "fresh": true
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-started",
          "examplePayload": {
            "agent": "build",
            "assistantMessageID": "msg_1",
            "model": {
              "id": "scripted",
              "providerID": "test"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
