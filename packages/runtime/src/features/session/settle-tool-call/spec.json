{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Settles a recorded tool call of the in-flight step with its content or its error (session.md: tool outcomes after durable calls).",
  "formatVersion": 1,
  "kind": "command",
  "name": "settleToolCall",
  "scenarios": [
    {
      "description": "A requested call succeeds with its content.",
      "expect": [
        {
          "eventType": "session-tool-settled",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "content": [
              {
                "text": "2",
                "type": "text"
              }
            ],
            "executed": false,
            "id": "call_1",
            "outcome": "succeeded",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-started",
          "examplePayload": {
            "agent": "build",
            "assistantMessageID": "msg_1",
            "model": {
              "id": "scripted",
              "providerID": "test"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-tool-requested",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executed": false,
            "id": "call_1",
            "input": {
              "code": "1"
            },
            "name": "execute",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "assistantMessageID": "msg_1",
        "content": [
          {
            "text": "2",
            "type": "text"
          }
        ],
        "id": "call_1",
        "sessionID": "ses_1"
      }
    },
