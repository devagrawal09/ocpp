{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Records how a live Session's instructions changed, as values referred to by hash, with the text the model is shown. The values the change introduces are stored in the same commit, before it. The host observes the change and stores nothing else.",
  "formatVersion": 1,
  "kind": "command",
  "name": "updateInstructions",
  "scenarios": [
    {
      "description": "A change that introduces values stores them first, in one commit.",
      "expect": [
        {
          "eventType": "session-instruction-blobs-stored",
          "examplePayload": {
            "blobs": {
              "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "Follow the style guide."
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-instructions-updated",
          "examplePayload": {
            "delta": {
              "global/old.md": "removed",
              "project/agents.md": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            },
            "sessionID": "ses_1",
            "text": "Instructions changed: project/agents.md"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "blobs": {
          "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa": "Follow the style guide."
        },
        "delta": {
          "global/old.md": "removed",
          "project/agents.md": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "sessionID": "ses_1",
        "text": "Instructions changed: project/agents.md"
      }
    },
    {
      "description": "A change to values already stored records only the change.",
      "expect": [
        {
          "eventType": "session-instructions-updated",
          "examplePayload": {
            "delta": {
              "global/old.md": "removed",
              "project/agents.md": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            },
            "sessionID": "ses_1",
            "text": "Instructions changed: project/agents.md"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "blobs": {},
        "delta": {
          "global/old.md": "removed",
          "project/agents.md": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "sessionID": "ses_1",
        "text": "Instructions changed: project/agents.md"
      }
    },
    {
      "description": "The initial baseline records an empty change without text.",
      "expect": [
        {
          "eventType": "session-instructions-updated",
          "examplePayload": {
            "delta": {},
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "delta": {},
        "sessionID": "ses_1"
      }
    },
    {
      "description": "An unknown Session is refused.",
      "expect": [],
      "given": [],
      "reject": {
        "reason": "Session not found"
      },
      "when": {
        "delta": {},
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A deleted Session is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-deleted",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Session deleted"
      },
      "when": {
        "delta": {},
        "sessionID": "ses_1"
      }
    }
  ]
}
