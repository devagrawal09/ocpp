{
  "$schema": "https://specter.dev/specification/v2/slice.schema.json",
  "description": "Commits a logical workspace ID for a provider, before any provider work. An ID names one workspace at a time: the same provider's workspace exists already, and another provider's is refused. A destroyed workspace's ID can be created again.",
  "formatVersion": 2,
  "kind": "command",
  "name": "createWorkspace",
  "scenarios": [
    {
      "description": "A new workspace is created for its provider.",
      "expect": [
        {
          "eventType": "workspace-created",
          "examplePayload": {
            "provider": "docker",
            "time": 1,
            "workspaceID": "wrk_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [],
      "when": {
        "provider": "docker",
        "time": 1,
        "workspaceID": "wrk_1"
      }
    },
    {
      "description": "The provider's workspace exists already, and the host answers with its ID.",
      "expect": [],
      "given": [
        {
          "eventType": "workspace-created",
          "examplePayload": {
            "provider": "docker",
            "time": 1,
            "workspaceID": "wrk_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "workspace-already-exists"
      },
      "when": {
        "provider": "docker",
        "time": 2,
        "workspaceID": "wrk_1"
      }
    },
    {
      "description": "Another provider's workspace under the ID is refused.",
      "expect": [],
      "given": [
        {
          "eventType": "workspace-created",
          "examplePayload": {
            "provider": "docker",
            "time": 1,
            "workspaceID": "wrk_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "code": "workspace-other-provider"
      },
      "when": {
        "provider": "e2b",
        "time": 2,
        "workspaceID": "wrk_1"
      }
    },
    {
      "description": "A destroyed workspace's ID is created again.",
      "expect": [
        {
          "eventType": "workspace-created",
          "examplePayload": {
            "provider": "e2b",
            "time": 1,
            "workspaceID": "wrk_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "workspace-created",
          "examplePayload": {
            "provider": "docker",
            "time": 1,
            "workspaceID": "wrk_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "workspace-destroyed",
          "examplePayload": {
            "workspaceID": "wrk_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "provider": "e2b",
        "time": 1,
        "workspaceID": "wrk_1"
      }
    }
  ]
}
