{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Commits the staged revert: the Session history ends at the boundary (protocol: session.revert.commit).",
  "formatVersion": 1,
  "kind": "command",
  "name": "commitRevert",
  "scenarios": [
    {
      "description": "Committing a staged revert records the boundary message as `to`.",
      "expect": [
        {
          "eventType": "session-revert-committed",
          "examplePayload": {
            "sessionID": "ses_1",
            "to": "msg_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "messageID": "msg_1"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A moved boundary commits at the latest staged message.",
      "expect": [
        {
          "eventType": "session-revert-committed",
          "examplePayload": {
            "sessionID": "ses_1",
            "to": "msg_2"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "messageID": "msg_1"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "messageID": "msg_2"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A revert can be staged and committed again after a previous commit.",
      "expect": [
        {
          "eventType": "session-revert-committed",
          "examplePayload": {
            "sessionID": "ses_1",
            "to": "msg_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "messageID": "msg_2"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-committed",
          "examplePayload": {
            "sessionID": "ses_1",
            "to": "msg_2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "messageID": "msg_1"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "Nothing staged: no revert to commit.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "No revert staged"
      },
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A cleared revert cannot be committed.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "messageID": "msg_1"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-cleared",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "No revert staged"
      },
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A revert that was already committed cannot be committed twice.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "messageID": "msg_1"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-committed",
          "examplePayload": {
            "sessionID": "ses_1",
            "to": "msg_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "No revert staged"
      },
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "Staged reverts belong to their own Session: another Session has nothing to commit.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_2",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "messageID": "msg_1"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "No revert staged"
      },
      "when": {
        "sessionID": "ses_2"
      }
    },
    {
      "description": "An active execution makes the Session busy.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "messageID": "msg_1"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Session is busy"
      },
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A settled execution (succeeded, failed or interrupted) does not make the Session busy.",
      "expect": [
        {
          "eventType": "session-revert-committed",
          "examplePayload": {
            "sessionID": "ses_1",
            "to": "msg_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-revert-staged",
          "examplePayload": {
            "revert": {
              "messageID": "msg_1"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-settled",
          "examplePayload": {
            "outcome": "succeeded",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-settled",
          "examplePayload": {
            "error": {
              "message": "boom",
              "type": "provider"
            },
            "outcome": "failed",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-settled",
          "examplePayload": {
            "outcome": "interrupted",
            "reason": "user",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "An unknown Session is not found.",
      "expect": [],
      "given": [],
      "reject": {
        "reason": "Session not found"
      },
      "when": {
        "sessionID": "ses_missing"
      }
    }
  ]
}
