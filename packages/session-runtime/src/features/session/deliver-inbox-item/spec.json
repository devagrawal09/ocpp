          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Inbox item already cancelled"
      },
      "when": {
        "inboxID": "msg_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "An inbox item that was never admitted cannot be delivered.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Inbox item not found"
      },
      "when": {
        "inboxID": "msg_missing",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "Cross-Session reuse fails: an item owned by another Session is not found in this one.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_2",
            "slug": "calm-heron",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "steer",
              "payload": {
                "text": "hello"
              },
              "type": "user"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Inbox item not found"
      },
      "when": {
        "inboxID": "msg_1",
        "sessionID": "ses_2"
      }
    },
    {
      "description": "Delivery requires an active execution: with no execution started, a pending item cannot be delivered.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "steer",
              "payload": {
                "text": "hello"
              },
              "type": "user"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Execution not active"
      },
      "when": {
