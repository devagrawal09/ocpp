{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Delivers a pending inbox item into Session History (session.md: Prompt Admission Precedes Execution).",
  "formatVersion": 1,
  "kind": "command",
  "name": "deliverInboxItem",
  "scenarios": [
    {
      "description": "The session.inbox.delivered projection consumes the pending row: a pending item is delivered.",
      "expect": [
        {
          "eventType": "session-inbox-delivered",
          "examplePayload": {
            "inboxID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "steer",
              "payload": {
                "text": "hello"
              },
              "type": "user"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "inboxID": "msg_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "Delivering a move item moves the Session to its destination in the same commit.",
      "expect": [
        {
          "eventType": "session-inbox-delivered",
          "examplePayload": {
            "inboxID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-moved",
          "examplePayload": {
            "location": {
              "directory": "/tmp/other"
            },
            "projectID": "prj_2",
            "sessionID": "ses_1",
            "subpath": "pkg"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "steer",
              "payload": {
                "location": {
                  "directory": "/tmp/other"
                },
                "projectID": "prj_2",
                "subpath": "pkg"
              },
              "type": "move"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "inboxID": "msg_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "Delivery consumes one item at a time: a second pending item stays deliverable after the first is delivered.",
      "expect": [
        {
          "eventType": "session-inbox-delivered",
          "examplePayload": {
            "inboxID": "msg_2",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "steer",
              "payload": {
                "text": "hello"
              },
              "type": "user"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_2",
            "item": {
              "delivery": "steer",
              "payload": {
                "text": "hello"
              },
              "type": "user"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-delivered",
          "examplePayload": {
            "inboxID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "inboxID": "msg_2",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "The projection consumed the row, so an already delivered item cannot be delivered again.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "steer",
              "payload": {
                "text": "hello"
              },
              "type": "user"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-delivered",
          "examplePayload": {
            "inboxID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Inbox item already delivered"
      },
      "when": {
        "inboxID": "msg_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A cancelled item never becomes visible history.",
      "expect": [],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "steer",
              "payload": {
                "text": "hello"
              },
              "type": "user"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-cancelled",
          "examplePayload": {
            "inboxID": "msg_1",
            "sessionID": "ses_1"
