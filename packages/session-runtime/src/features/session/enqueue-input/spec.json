{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Admits a user or synthetic input to a Session inbox before execution begins (session.md: Prompt Admission Precedes Execution).",
  "formatVersion": 1,
  "kind": "command",
  "name": "enqueueInput",
  "scenarios": [
    {
      "description": "Session.prompt publishes one durable session.inbox.enqueued fact; the input stays pending outside Session History until delivery.",
      "expect": [
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "steer",
              "payload": {
                "text": "Inspect the failing tests"
              },
              "type": "user"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "inboxID": "msg_1",
        "payload": {
          "text": "Inspect the failing tests"
        },
        "sessionID": "ses_1",
        "type": "user"
      }
    },
    {
      "description": "A coalesced notice replaces the pending notices admitted under its key: they are cancelled in the same commit, and it carries the key.",
      "expect": [
        {
          "eventType": "session-inbox-cancelled",
          "examplePayload": {
            "inboxID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-cancelled",
          "examplePayload": {
            "inboxID": "msg_2",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_3",
            "item": {
              "delivery": "steer",
              "payload": {
                "metadata": {
                  "coalesce": "notify:build"
                },
                "text": "both notices"
              },
              "type": "synthetic"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "steer",
              "payload": {
                "metadata": {
                  "coalesce": "notify:build"
                },
                "text": "first notice"
              },
              "type": "synthetic"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_2",
            "item": {
              "delivery": "steer",
              "payload": {
                "metadata": {
                  "coalesce": "notify:build"
                },
                "text": "second notice"
              },
              "type": "synthetic"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "coalesce": {
          "key": "notify:build",
          "replaces": [
            "msg_1",
            "msg_2"
          ]
        },
        "inboxID": "msg_3",
        "payload": {
          "text": "both notices"
        },
        "sessionID": "ses_1",
        "type": "synthetic"
      }
    },
    {
