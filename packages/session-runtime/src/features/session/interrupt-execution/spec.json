{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Interrupts the active execution of a Session without touching pending input (session.md: Execution Is Process-Local). OC++ treats idle/settled interrupt as a public no-op; the app models it as a rejection and the M4 facade translates it back.",
  "formatVersion": 1,
  "kind": "command",
  "name": "interruptExecution",
  "scenarios": [
    {
      "description": "Interruption stops locally owned execution: an active execution is interrupted (reason defaults to user).",
      "expect": [
        {
          "eventType": "session-execution-settled",
          "examplePayload": {
            "outcome": "interrupted",
            "reason": "user",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "An open tool call is settled atomically with the interrupt: one aborted tool failure (naming the tool) precedes the interrupted execution in the same commit.",
      "expect": [
        {
          "eventType": "session-tool-settled",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "error": {
              "message": "Tool execution interrupted: execute",
              "type": "aborted"
            },
            "executed": false,
            "id": "call_1",
            "outcome": "failed",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-settled",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "error": {
              "message": "Step interrupted",
              "type": "aborted"
            },
            "outcome": "failed",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-settled",
          "examplePayload": {
            "outcome": "interrupted",
            "reason": "user",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-created",
          "examplePayload": {
            "location": {
              "directory": "/tmp/ws"
            },
            "projectID": "prj_1",
            "sessionID": "ses_1",
            "slug": "brave-otter",
            "version": "2"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-started",
          "examplePayload": {
            "agent": "build",
            "assistantMessageID": "msg_1",
            "model": {
              "id": "scripted",
              "providerID": "test"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-tool-requested",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "executed": false,
            "id": "call_1",
            "input": {
              "code": "x"
            },
            "name": "execute",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1"
      }
    },
