{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Records that a step's provider stream ended, before its local tools settle.",
  "formatVersion": 1,
  "kind": "command",
  "name": "recordStepStreamed",
  "scenarios": [
    {
      "description": "The step in flight records that its stream ended.",
      "expect": [
        {
          "eventType": "session-step-streamed",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-started",
          "examplePayload": {
            "agent": "build",
            "assistantMessageID": "msg_1",
            "model": {
              "id": "scripted",
              "providerID": "test"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "assistantMessageID": "msg_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "An attempt streams once.",
      "expect": [],
      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-started",
          "examplePayload": {
            "agent": "build",
            "assistantMessageID": "msg_1",
            "model": {
              "id": "scripted",
              "providerID": "test"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-streamed",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Step already streamed"
      },
      "when": {
        "assistantMessageID": "msg_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A retried attempt of the same step streams again.",
      "expect": [
        {
          "eventType": "session-step-streamed",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-started",
          "examplePayload": {
            "agent": "build",
            "assistantMessageID": "msg_1",
            "model": {
              "id": "scripted",
              "providerID": "test"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-streamed",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-settled",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "error": {
              "message": "connection reset",
              "type": "transport"
            },
            "outcome": "failed",
            "retry": {
              "at": 1000,
              "attempt": 1
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-started",
          "examplePayload": {
            "agent": "build",
            "assistantMessageID": "msg_1",
            "model": {
              "id": "scripted",
              "providerID": "test"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "assistantMessageID": "msg_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "Only the step in flight can stream.",
      "expect": [],
      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-started",
          "examplePayload": {
            "agent": "build",
            "assistantMessageID": "msg_1",
            "model": {
              "id": "scripted",
              "providerID": "test"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-settled",
          "examplePayload": {
            "assistantMessageID": "msg_1",
            "cost": 0,
            "finish": "tool-calls",
            "outcome": "succeeded",
            "sessionID": "ses_1",
            "tokens": {
              "cache": {
                "read": 0,
                "write": 0
              },
              "input": 0,
              "output": 0,
              "reasoning": 0
            }
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Step not in flight"
      },
      "when": {
        "assistantMessageID": "msg_1",
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A stream outside an active execution is rejected.",
      "expect": [],
      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-started",
          "examplePayload": {
            "agent": "build",
            "assistantMessageID": "msg_1",
            "model": {
              "id": "scripted",
              "providerID": "test"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-settled",
          "examplePayload": {
            "outcome": "succeeded",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "reject": {
        "reason": "Execution not active"
      },
      "when": {
        "assistantMessageID": "msg_1",
        "sessionID": "ses_1"
      }
    }
  ]
}
