{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Requests the next step for every Session with an active execution and no step in flight.",
  "formatVersion": 1,
  "kind": "reaction",
  "name": "runStep",
  "scenarios": [
    {
      "description": "A fresh retry runs as the next step, because the failed attempt's output stands: the next ordinal is requested.",
      "expect": [
        {
          "payload": {
            "ordinal": 1,
            "sessionID": "ses_1"
          },
          "type": "runStep"
        }
      ],
      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-started",
          "examplePayload": {
            "agent": "build",
            "assistantMessageID": "msg_step_0",
            "model": {
              "id": "scripted",
              "providerID": "test"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-step-settled",
          "examplePayload": {
            "assistantMessageID": "msg_step_0",
            "error": {
              "message": "connection reset",
              "type": "transport"
            },
            "outcome": "failed",
            "retry": {
              "at": 1000,
              "attempt": 1,
              "fresh": true
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ]
    },
    {
      "description": "A step still in flight when an execution starts belongs to a process that is gone: its ordinal is requested again, so a job reconciles it.",
