{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Reports a Session's executions (idle, active or settled, with the last outcome and whether pending input will wake it), its steps (the one in flight, its attempts, failure and open calls) and what its next step starts from (session.md: Execution Is Process-Local; One Step May Have Several Physical Attempts).",
  "formatVersion": 1,
  "kind": "query",
  "name": "sessionStatus",
  "scenarios": [
    {
      "description": "A Session with no events is idle (no busy period has started).",
      "expect": {
        "executions": 0,
        "lastOutcome": null,
        "next": {
          "attempt": 1,
          "boundary": "idle",
          "stepsInExecution": 0,
          "stepsSinceInput": 0
        },
        "status": "idle",
        "step": {
          "attempts": 0,
          "started": 0
        }
      },
      "given": [],
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "A started, unended execution is a busy period currently owned: active, at an idle boundary.",
      "expect": {
        "executions": 1,
        "lastOutcome": null,
        "next": {
          "attempt": 1,
          "boundary": "idle",
          "stepsInExecution": 0,
          "stepsSinceInput": 0
        },
        "status": "active",
        "step": {
          "attempts": 0,
          "started": 0
        }
      },
      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "Success ends the busy period: the Session is settled.",
      "expect": {
        "executions": 1,
        "lastOutcome": "succeeded",
        "next": {
          "attempt": 1,
          "boundary": "idle",
          "stepsInExecution": 0,
          "stepsSinceInput": 0
        },
        "status": "settled",
        "step": {
          "attempts": 0,
          "started": 0
        }
      },
      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-settled",
          "examplePayload": {
            "outcome": "succeeded",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "Failure ends the busy period: the Session is settled, with the error that failed it.",
      "expect": {
        "error": {
          "message": "boom",
          "type": "provider"
        },
        "executions": 1,
        "lastOutcome": "failed",
        "next": {
          "attempt": 1,
          "boundary": "idle",
          "stepsInExecution": 0,
          "stepsSinceInput": 0
        },
        "status": "settled",
        "step": {
          "attempts": 0,
          "started": 0
        }
      },
      "given": [
        {
          "eventType": "session-execution-started",
          "examplePayload": {
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        },
        {
          "eventType": "session-execution-settled",
          "examplePayload": {
            "error": {
              "message": "boom",
              "type": "provider"
            },
            "outcome": "failed",
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ],
      "when": {
        "sessionID": "ses_1"
      }
    },
    {
      "description": "Interruption ends the busy period: the Session is settled with outcome interrupted and its reason.",
      "expect": {
        "executions": 1,
        "lastOutcome": "interrupted",
        "next": {
          "attempt": 1,
          "boundary": "idle",
          "stepsInExecution": 0,
          "stepsSinceInput": 0
        },
        "reason": "user",
        "status": "settled",
        "step": {
          "attempts": 0,
          "started": 0
        }
