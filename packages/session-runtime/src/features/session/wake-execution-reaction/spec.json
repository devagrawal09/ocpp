{
  "$schema": "https://specter.dev/specification/v1/slice.schema.json",
  "description": "Schedules execution after input is recorded: requests startExecution on session.inbox.enqueued unless the input is held or the Session is already active (session.md: Execution Is Process-Local).",
  "formatVersion": 1,
  "kind": "reaction",
  "name": "wakeExecution",
  "scenarios": [
    {
      "description": "Omitted or true records the input, then schedules SessionExecution.wake: an enqueue on an idle Session requests a start.",
      "expect": [
        {
          "payload": {
            "sessionID": "ses_1"
          },
          "type": "startExecution"
        }
      ],
      "given": [
        {
          "eventType": "session-inbox-enqueued",
          "examplePayload": {
            "inboxID": "msg_1",
            "item": {
              "delivery": "steer",
              "payload": {
                "text": "hello"
              },
              "type": "user"
            },
            "sessionID": "ses_1"
          },
          "kind": "scenario-event"
        }
      ]
    },
    {
      "description": "Explicit resumes join the active execution, and repeated wakes coalesce: an enqueue while active requests nothing.",
      "expect": [],
      "given": [
